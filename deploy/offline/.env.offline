# =============================================================================
# 内网离线部署环境变量模板
# =============================================================================
# 所有 〈...〉 占位符必须替换为内网实际值。复制为 .env 后填写:
#   cp .env.offline .env && vi .env
#
# <DEPLOY_HOST> = 部署本系统的内网机器 IP(用户浏览器访问的地址),如 10.0.0.10
# =============================================================================

# ---------------------------------------------------------------------------
# [必填] 复用的内网 Redis(Celery broker)
# ---------------------------------------------------------------------------
REDIS_HOST=〈REDIS_IP〉
REDIS_PORT=〈REDIS_PORT〉
REDIS_DB=0

# ---------------------------------------------------------------------------
# [必填] 复用的内网 MinIO(对象存储,PPT 源文件/预览/缩略图)
#   MINIO_ENDPOINT         = 容器内访问 MinIO 的地址(IP:PORT)
#   MINIO_EXTERNAL_ENDPOINT= 浏览器访问 MinIO 的地址(取缩略图/预览用),
#                            必须是用户浏览器能访问的地址,通常 = <DEPLOY_HOST>:<对外的 MinIO 端口>
#                            若 MinIO 在内网别处,用该机器 IP:端口
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=〈MINIO_IP〉:〈MINIO_PORT〉
MINIO_EXTERNAL_ENDPOINT=〈DEPLOY_HOST〉:〈MINIO对外端口〉
MINIO_ACCESS_KEY=〈MINIO_AK〉
MINIO_SECRET_KEY=〈MINIO_SK〉
MINIO_BUCKET=ppt-library
MINIO_SECURE=false

# ---------------------------------------------------------------------------
# [必填] 复用的内网 Authentik(SSO 登录)
#   OIDC_ISSUER          = 浏览器与后端都访问的 issuer 地址
#   OIDC_REDIRECT_URI    = 登录回调,必须 = http://<DEPLOY_HOST>:13000/api/auth/callback
#                          且必须在 Authentik provider 的 redirect_uris 白名单里
#   OIDC_CLIENT_SECRET   = 从 Authentik provider 拿(运行 setup-ppt-provider.py 时输出)
# ---------------------------------------------------------------------------
OIDC_ENABLED=true
OIDC_ISSUER=http://〈AUTHENTIK_IP〉:〈AUTHENTIK_PORT〉/application/o/ppt-library
OIDC_INTERNAL_ISSUER=http://〈AUTHENTIK_IP〉:〈AUTHENTIK_PORT〉/application/o/ppt-library
OIDC_CLIENT_ID=ppt-library
OIDC_CLIENT_SECRET=〈从 Authentik provider 获取〉
OIDC_REDIRECT_URI=http://〈DEPLOY_HOST〉:13000/api/auth/callback
OIDC_SUPERUSER_GROUP=ppt-admins
WEB_BASE_URL=http://〈DEPLOY_HOST〉:13000
SESSION_MAX_AGE=86400

# ---------------------------------------------------------------------------
# [必填] 复用的内网 MinerU(PDF/PPT 解析)
# ---------------------------------------------------------------------------
MINERU_API_URL=http://〈MINERU_IP〉:8765

# ---------------------------------------------------------------------------
# [必填] 复用的内网 Embedding 服务(bge-m3,OpenAI 兼容 /v1/embeddings)
# ---------------------------------------------------------------------------
EMBEDDING_SERVICE_URL=http://〈EMBEDDING_IP〉:9997
DEFAULT_EMBEDDING_MODEL=bge-m3

# ---------------------------------------------------------------------------
# [可选] 视觉 AI 模型(给 PPT 每页生成 AI 摘要 + 标签)
#   不在 env 配置 —— 部署后在「设置 → 模型配置」页填写(OpenAI 兼容视觉模型)。
#   留空 = 降级运行(渲染/检索/SSO 全部正常,仅缺 AI 摘要/标签)。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Postgres(默认用 compose 自带的 pgvector/pgvector:pg16)
#   想复用内网 PG?前提:内网 PG 已装 pgvector + pg_trgm 扩展。
#   满足则设 POSTGRES_HOST=〈内网PG_IP〉,并在 docker-compose.offline.yml 删 postgres 服务。
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pptlibrary
POSTGRES_USER=pptlibrary
POSTGRES_PASSWORD=〈生产强密码〉

# ---------------------------------------------------------------------------
# [必填] 密钥(生产环境务必随机生成,见下方生成命令)
# ---------------------------------------------------------------------------
# 生成:openssl rand -hex 32
SECRET_KEY=〈openssl rand -hex 32〉
# 生成:python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=〈Fernet key〉

# ---------------------------------------------------------------------------
# Bootstrap 管理员(SSO 失效时兜底登录;内网 SSO 正常则用不到)
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=〈生产强密码〉

# ---------------------------------------------------------------------------
# 部署机对外端口(用户访问)
# ---------------------------------------------------------------------------
WEB_HOST_PORT=13000
API_HOST_PORT=18000
POSTGRES_HOST_PORT=15432

# ---------------------------------------------------------------------------
# 上传限制
# ---------------------------------------------------------------------------
UPLOAD_MAX_SIZE_MB=200
