# PPT 素材库 — 环境变量示例
# 复制为 .env 并按需修改。

# --- Database ---
POSTGRES_DB=pptlibrary
POSTGRES_USER=pptlibrary
POSTGRES_PASSWORD=pptlibrary

# --- MinIO ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Bootstrap admin (PRD §3.1) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# --- App secrets ---
SECRET_KEY=dev-secret-change-me
# Fernet master key for API keys (ADR-0006). Generate new with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=dGVzdC1tYXN0ZXIta2V5LTEyMzQ1Njc4OTAxMjM0NTY=

# --- Embedding service (ADR-0008): host-side OpenAI-compatible /v1/embeddings.
#     Default embedding config is auto-seeded on first startup from these values.
#     Container reaches the host service over the docker0 bridge (172.17.0.1). ---
EMBEDDING_SERVICE_URL=http://172.17.0.1:9997
DEFAULT_EMBEDDING_MODEL=bge-m3
