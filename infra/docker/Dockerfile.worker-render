# Render worker image (ADR-0005): includes LibreOffice + CJK fonts.
# Built on the same base as api to keep deps consistent.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libxml2-dev libxslt1-dev libpq-dev \
    libreoffice libreoffice-impress fonts-noto-cjk fonts-noto-cjk-extra \
    poppler-utils imagemagick \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Each container runs ONE concurrency (ADR-0005). prefetch=1 set in celery config.
CMD ["celery", "-A", "app.tasks.celery_app", "worker", \
     "-Q", "render", "--concurrency=1", "--loglevel=info", \
     "-n", "render@%h"]
